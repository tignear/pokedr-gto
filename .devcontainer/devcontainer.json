// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers-extra/features/ripgrep:1": {}
	},

	"runArgs": [
		"--device=/dev/dxg"
	],

	"mounts": [
		{
			"source": "devcontainer-codex-home-${devcontainerId}",
			"target": "/home/vscode/.codex",
			"type": "volume"
		},
		{
			"source": "\\\\wsl.localhost\\Ubuntu-24.04\\usr\\lib\\wsl\\lib\\libdxcore.so",
			"target": "/usr/lib/libdxcore.so",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\Ubuntu-24.04\\usr\\lib\\wsl\\lib",
			"target": "/usr/lib/wsl/lib",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\Ubuntu-24.04\\usr\\lib\\wsl\\drivers",
			"target": "/usr/lib/wsl/drivers",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\Ubuntu-24.04\\usr\\lib\\x86_64-linux-gnu\\libvulkan_dzn.so",
			"target": "/usr/lib/x86_64-linux-gnu/libvulkan_dzn.so",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\Ubuntu-24.04\\usr\\lib\\x86_64-linux-gnu\\libspirv_to_dxil.so",
			"target": "/usr/lib/x86_64-linux-gnu/libspirv_to_dxil.so",
			"type": "bind"
		}
	],

	"remoteEnv": {
		"CODEX_HOME": "/home/vscode/.codex",
		"PATH": "${containerEnv:PATH}:/home/vscode/.local/bin",
		"LD_LIBRARY_PATH": "/usr/lib/wsl/lib:/usr/lib/x86_64-linux-gnu:${containerEnv:LD_LIBRARY_PATH}",
		"VK_ICD_FILENAMES": "/usr/share/vulkan/icd.d/dzn_icd.x86_64.json",
		"WGPU_BACKEND": "vulkan",
		"WGPU_ALLOW_UNDERLYING_NONCOMPLIANT_ADAPTER": "1"
	},

	"postCreateCommand": "bash .devcontainer/install-codex.sh"

	// Use 'mounts' to make the cargo cache persistent in a Docker Volume.
	// "mounts": [
	// 	{
	// 		"source": "devcontainer-cargo-cache-${devcontainerId}",
	// 		"target": "/usr/local/cargo",
	// 		"type": "volume"
	// 	}
	// ]

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "rustc --version",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
